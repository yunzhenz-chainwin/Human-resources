APP_ENV=development
AUTH_SECRET_KEY=change-me-to-at-least-32-random-characters
AUTH_ACCESS_MINUTES=15
AUTH_REFRESH_DAYS=7
# Only set these three values for the first administrator bootstrap, then remove them.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
POSTGRES_DB=talenthub
POSTGRES_USER=talenthub
POSTGRES_PASSWORD=talenthub_dev_only
DATABASE_URL=postgresql+psycopg://talenthub:talenthub_dev_only@postgres:5432/talenthub
REDIS_URL=redis://redis:6379/0
RESUME_STORAGE_PROVIDER=local
RESUME_STORAGE_PATH=./storage/resumes
RESUME_QUARANTINE_PATH=./storage/quarantine
RESUME_MAX_BYTES=10485760
CANDIDATE_PHOTO_STORAGE_PATH=./storage/candidate-photos
CANDIDATE_PHOTO_MAX_BYTES=5242880
# Malware scanning of uploaded resumes.
# Dev default below is fail-open (no scanner) so local uploads work without ClamAV.
# PRODUCTION MUST be fail-closed — run ClamAV and set:
#   RESUME_SCANNER=clamav
#   RESUME_SCAN_POLICY=fail   # reject any upload that could not be scanned clean
# (APP_ENV=production/staging is already treated as fail-closed in code; set these
# explicitly so unscanned uploads are rejected in every environment.)
RESUME_SCANNER=none
RESUME_SCAN_POLICY=allow_unavailable
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10
S3_BUCKET=talenthub-resumes
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
# Placeholder only — never ship this value.  Set a strong secret in the real
# environment; the storage compose file refuses to start if S3_SECRET_KEY is unset.
S3_SECRET_KEY=change-me-to-a-strong-secret
S3_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081
