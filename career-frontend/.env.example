# Keep the public site focused on talent-pool registration by default.
# Set to false to expose the home page, published jobs, and job detail views.
VITE_PUBLIC_ONLY_APPLY=true

# Show a public recruiting contact only after the mailbox/domain is approved.
# VITE_CAREERS_EMAIL=careers@company.example

# Optional overrides for local development or static preview deployments.
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:8010
# VITE_ALLOWED_HOSTS=talenthub,talenthub.company.local
