# Base URL the browser bundle calls; defaults to the relative /api/v1, which the
# vite dev server (and the LAN preview) proxies to the backend.
# VITE_API_BASE_URL=/api/v1
# Where the dev-server /api proxy forwards to; defaults to the local backend.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8010
# Extra hostnames (comma separated) allowed to reach the dev/preview server,
# on top of localhost and this machine's hostname.
# VITE_ALLOWED_HOSTS=hr.internal.example
